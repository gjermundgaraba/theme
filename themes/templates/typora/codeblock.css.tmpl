@charset "UTF-8";
/* Generated by gg-theme from colors.Palette. Do not edit build output. */

/** code highlight */

.cm-s-inner .cm-operator {
    color: {{.SyntaxKeyword}};
}

.cm-s-inner .cm-property {
    color: {{.FG}};
}

.cm-s-inner .cm-keyword {
    color: {{.SyntaxKeyword}};
}

.cm-s-inner .cm-tag {
    color: {{.SyntaxKeyword}};
}

.cm-s-inner .cm-attribute {
    color: {{.SyntaxBuiltin}};
}

.CodeMirror div.CodeMirror-cursor {
    border-left: 1px solid {{.FG}};
    z-index: 3;
}

.cm-s-inner .cm-string,
.cm-s-inner .cm-string-2 {
    color: {{.SyntaxString}};
}

.cm-s-inner .cm-comment,
.cm-s-inner.cm-comment {
    color: {{.SyntaxComment}};
}

.cm-s-inner .cm-header,
.cm-s-inner.cm-header,
.cm-s-inner .cm-def,
.cm-s-inner.cm-def {
    color: {{.SyntaxFunction}};
}

.cm-s-inner .cm-quote,
.cm-s-inner.cm-quote {
    color: {{.SyntaxBuiltin}};
}

.cm-s-inner .cm-hr {
    color: {{.SyntaxComment}};
}

.cm-s-inner .cm-link {
    color: {{.SyntaxLink}};
}

.cm-s-inner .cm-negative {
    color: {{.SyntaxError}};
}

.cm-s-inner .cm-positive {
    color: {{.SyntaxBuiltin}};
}

.cm-s-inner .cm-meta,
.cm-s-inner .cm-qualifier,
.cm-s-inner .cm-builtin {
    color: {{.SyntaxBuiltin}};
}

.cm-s-inner .cm-bracket {
    color: {{.FG}};
}

.cm-s-inner .cm-atom,
.cm-s-inner.cm-atom {
    color: {{.SyntaxConstant}};
}

.cm-s-inner .cm-number {
    color: {{.SyntaxNumber}};
}

.cm-s-inner .cm-variable,
.cm-s-inner .cm-variable-2 {
    color: {{.FG}};
}

.cm-s-inner .cm-variable-3 {
    color: {{.SyntaxConstant}};
}

.CodeMirror-selectedtext,
.CodeMirror-selected {
    background: {{.SelectionBG}};
    color: {{.SelectionFG}} !important;
    text-shadow: none;
}
